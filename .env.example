# ===========================================
# CivicPulse AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_ML_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=CivicPulse AI

# ---- Backend API ----
API_PORT=5000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse_dev_password
DATABASE_URL=postgresql://civicpulse:civicpulse_dev_password@localhost:5432/civicpulse

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=civicpulse_redis_dev

# ---- MinIO ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=civicpulse_minio
MINIO_ROOT_PASSWORD=civicpulse_minio_dev_password
MINIO_BUCKET=civicpulse-images
MINIO_USE_SSL=false

# ---- ML Service ----
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_PORT=5001
