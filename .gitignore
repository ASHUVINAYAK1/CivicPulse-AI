# ==========================================
# CivicPulse-AI - Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment & Secrets (keep example templates)
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.cert
*.crt

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
*.egg
.eggs/

# Testing, Type Checking & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
.coverage.*
htmlcov/
.nyc_output/

# Machine Learning Checkpoints & Weights
# (Prevents large binary weights from bloating Git history)
*.pt
*.pth
*.h5
*.hdf5
*.pkl
*.joblib
*.onnx
*.tflite
*.pb
*.safetensors
*.bin
*.weights
*.ckpt
*.torchscript
*.engine

# Experiment Tracking & MLflow
mlruns/
mlartifacts/
.mlflow/

# Local Databases & State Stores
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
mlflow.db

# Datasets (Preserve folder structure via .gitkeep, ignore actual dataset files)
datasets/raw/*
datasets/processed/*
datasets/annotations/*
datasets/synthetic/*
datasets/splits/*
!datasets/**/.gitkeep

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
*.tgz
*.tar.gz

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Docker overrides
docker-compose.override.yml
