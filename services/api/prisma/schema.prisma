// =======================================================
// CivicPulse AI - Complete Prisma Database Schema
// Based on PRD Version 2.0 (Section 5 Database Design)
// =======================================================

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum UserRole {
  citizen
  inspector
  administrator
  maintenance_team
  ml_admin

  @@map("user_role")
}

// -------------------------------------------------------
// 1. Users
// -------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  role         UserRole @default(citizen)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relationships
  reportedIncidents   Incident[]             @relation("ReportedIncidents")
  assignedMaintenance MaintenanceTask[]      @relation("AssignedMaintenanceTasks")
  createdMaintenance  MaintenanceTask[]      @relation("CreatedMaintenanceTasks")
  verifications       IncidentVerification[] @relation("InspectorVerifications")
  auditLogs           AuditLog[]             @relation("UserAuditLogs")

  @@map("users")
}

// -------------------------------------------------------
// 2. Incidents
// -------------------------------------------------------

model Incident {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentNumber String    @unique @map("incident_number") @db.VarChar(30)
  reporterId     String    @map("reporter_id") @db.Uuid
  title          String    @db.VarChar(200)
  description    String    @db.Text
  damageType     String    @map("damage_type") @db.VarChar(50)
  severity       String?   @db.VarChar(30)
  status         String    @default("submitted") @db.VarChar(40)
  priority       String?   @db.VarChar(20)
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  address        String?   @db.Text
  reportedAt     DateTime  @default(now()) @map("reported_at") @db.Timestamp(6)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relationships
  reporter      User                   @relation("ReportedIncidents", fields: [reporterId], references: [id], onDelete: Cascade)
  images        IncidentImage[]
  predictions   AiPrediction[]
  verifications IncidentVerification[]
  tasks         MaintenanceTask[]

  @@index([status])
  @@index([damageType])
  @@index([severity])
  @@index([reportedAt])
  @@index([latitude, longitude])
  @@map("incidents")
}

// -------------------------------------------------------
// 3. Incident Images
// -------------------------------------------------------

model IncidentImage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId       String   @map("incident_id") @db.Uuid
  storageKey       String   @map("storage_key") @db.Text
  originalFilename String   @map("original_filename") @db.Text
  contentType      String   @map("content_type") @db.VarChar(100)
  fileSize         BigInt   @map("file_size")
  imageType        String   @default("report") @map("image_type") @db.VarChar(30)
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)

  // Relationships
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_images")
}

// -------------------------------------------------------
// 4. AI Predictions
// -------------------------------------------------------

model AiPrediction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId        String   @map("incident_id") @db.Uuid
  modelVersionId    String?  @map("model_version_id") @db.Uuid
  predictionType    String   @map("prediction_type") @db.VarChar(50)
  predictedClass    String   @map("predicted_class") @db.VarChar(100)
  confidence        Float
  predictionPayload Json?    @map("prediction_payload")
  processingTimeMs  Int?     @map("processing_time_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relationships
  incident      Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  modelRegistry ModelRegistry? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([predictionType])
  @@index([createdAt])
  @@map("ai_predictions")
}

// -------------------------------------------------------
// 5. Incident Verifications
// -------------------------------------------------------

model IncidentVerification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId        String   @map("incident_id") @db.Uuid
  inspectorId       String   @map("inspector_id") @db.Uuid
  predictedClass    String?  @map("predicted_class") @db.VarChar(100)
  verifiedClass     String   @map("verified_class") @db.VarChar(100)
  predictedSeverity String?  @map("predicted_severity") @db.VarChar(30)
  verifiedSeverity  String   @map("verified_severity") @db.VarChar(30)
  remarks           String?  @db.Text
  verifiedAt        DateTime @default(now()) @map("verified_at") @db.Timestamp(6)

  // Relationships
  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  inspector User     @relation("InspectorVerifications", fields: [inspectorId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([inspectorId])
  @@map("incident_verifications")
}

// -------------------------------------------------------
// 6. Maintenance Tasks
// -------------------------------------------------------

model MaintenanceTask {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId        String    @map("incident_id") @db.Uuid
  assignedTo        String?   @map("assigned_to") @db.Uuid
  assignedBy        String    @map("assigned_by") @db.Uuid
  taskStatus        String    @default("pending") @map("task_status") @db.VarChar(40)
  priority          String    @default("medium") @db.VarChar(20)
  estimatedCost     Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  actualCost        Decimal?  @map("actual_cost") @db.Decimal(12, 2)
  estimatedDuration Int?      @map("estimated_duration")
  actualDuration    Int?      @map("actual_duration")
  startedAt         DateTime? @map("started_at") @db.Timestamp(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  // Relationships
  incident Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignee User?               @relation("AssignedMaintenanceTasks", fields: [assignedTo], references: [id], onDelete: SetNull)
  assigner User                @relation("CreatedMaintenanceTasks", fields: [assignedBy], references: [id], onDelete: Cascade)
  updates  MaintenanceUpdate[]

  @@index([taskStatus])
  @@index([assignedTo])
  @@index([incidentId])
  @@map("maintenance_tasks")
}

// -------------------------------------------------------
// 7. Maintenance Updates
// -------------------------------------------------------

model MaintenanceUpdate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  previousStatus String   @map("previous_status") @db.VarChar(40)
  newStatus      String   @map("new_status") @db.VarChar(40)
  remarks        String?  @db.Text
  imageId        String?  @map("image_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relationships
  task MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("maintenance_updates")
}

// -------------------------------------------------------
// 8. Model Registry
// -------------------------------------------------------

model ModelRegistry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelName       String   @map("model_name") @db.VarChar(150)
  modelType       String   @map("model_type") @db.VarChar(50)
  version         String   @db.VarChar(50)
  framework       String   @db.VarChar(50)
  artifactUri     String   @map("artifact_uri") @db.Text
  metrics         Json?
  trainingDataset String   @map("training_dataset") @db.VarChar(200)
  status          String   @default("experimental") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relationships
  predictions AiPrediction[]
  forecasts   IncidentForecast[]

  @@unique([modelName, version])
  @@map("model_registry")
}

// -------------------------------------------------------
// 9. Audit Logs
// -------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relationships
  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------
// 10. Incident Forecasts
// -------------------------------------------------------

model IncidentForecast {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId           String   @map("region_id") @db.VarChar(100)
  modelVersionId     String?  @map("model_version_id") @db.Uuid
  forecastPeriod     DateTime @map("forecast_period") @db.Date
  predictedIncidents Float    @map("predicted_incidents")
  lowerBound         Float?   @map("lower_bound")
  upperBound         Float?   @map("upper_bound")
  generatedAt        DateTime @default(now()) @map("generated_at") @db.Timestamp(6)

  // Relationships
  modelRegistry ModelRegistry? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([regionId, forecastPeriod])
  @@map("incident_forecasts")
}
